        "feather": [
          "INT",
          {
            "default": 0,
            "min": 0,
            "max": 64,
            "step": 1,
            "tooltip": "Gaussian blur radius (in latent pixels) on mask edges. 0 = hard edges."
          }
        ],
        "reference_index": [
          "INT",
          {
            "default": 0,
            "min": 0,
            "max": 7,
            "step": 1,
            "tooltip": "Which reference latent to attenuate when multiple are connected (0 = first)."
          }
        ],
        "debug": [
          "BOOLEAN",
          {
            "default": false
          }
        ]
      }
    },
    "input_order": {
