        ]
      },
      "optional": {
        "strength": [
          "FLOAT",
          {
            "default": 1.0,
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "tooltip": "Attenuation strength in the BLACK regions of the mask. 1.0 = black regions multiplied by 0 (full attenuation). 0.5 = black regions kept at 50% of ref strength. 0.0 = mask ignored, ref passes through everywhere."
          }
        ],
        "invert_mask": [
          "BOOLEAN",
          {
            "default": false,
            "tooltip": "Flip black/white. Enable if you painted the area you want attenuated rather than preserved."
