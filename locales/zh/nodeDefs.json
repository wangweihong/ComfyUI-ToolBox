      },
      "auto_walls": {
        "name": "自动隔开"
      },
      "fields": {
        "name": "求解结果"
      },
      "guides": {
        "name": "引导数据"
      },
      "batch_mode": {
        "name": "批次模式"
      },
      "checkpoint": {
        "name": "本地点选权重"
      },
      "device": {
        "name": "设备"
      },
      "model": {
        "name": "深度模型"
      },
      "effects_json": {
        "name": "花纹、文字与损伤",
        "tooltip": "版本 1 效果配置；在纹理编辑面板中调整。"
      },
      "renderer_version": {
        "name": "渲染版本"
      },
      "layer_mode": {
        "name": "透明图层模式"
      },
      "moire_on": {
        "name": "摩尔纹"
      },
      "moire": {
